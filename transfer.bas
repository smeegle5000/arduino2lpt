OUT &H37A, &H80
DIM t AS INTEGER
DIM size AS LONG
size = 37030

DO
  DO WHILE (INP(&H379) AND &H40) = 0
  LOOP
  t = INP(&H378)
  OUT &H37A, &H81
  DO WHILE (INP(&H379) AND &H40) <> 0
  LOOP
  OUT &H37A, &H80
LOOP WHILE t <> &H90

FOR i = 0 TO 63
  DO WHILE (INP(&H379) AND &H40) = 0
  LOOP
  t = INP(&H378)
  OUT &H37A, &H81
  DO WHILE (INP(&H379) AND &H40) <> 0
  LOOP
  OUT &H37A, &H80
NEXT i

OPEN "RECIEVED.EXE" FOR BINARY AS #1
DIM c AS STRING * 1
FOR i = 0 TO size - 1
  DO WHILE (INP(&H379) AND &H40) = 0
  LOOP
  b% = INP(&H378)
  c = CHR$(b%)
  PUT #1, , c
  OUT &H37A, &H81
  DO WHILE (INP(&H379) AND &H40) <> 0
  LOOP
  OUT &H37A, &H80
NEXT i
CLOSE #1
PRINT "Complete"